{
  "name": "mysql-desktop-client",
  "productName": "点点够MySQL客户端",
  "version": "1.1.0",
  "description": "An open-source MySQL desktop client for macOS",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build:prod",
    "build": "tsc && webpack",
    "build:prod": "cross-env NODE_ENV=production tsc && webpack",
    "package": "npm run build:prod && electron-builder",
    "dist": "npm run build:prod && electron-builder --publish=never",
    "dist:mac": "npm run build:prod && electron-builder --mac",
    "dist:dmg": "npm run build:prod && electron-builder --mac dmg"
  },
  "keywords": [
    "mysql",
    "database",
    "client",
    "gui",
    "electron",
    "sql",
    "database-management",
    "mysql-client",
    "database-tool",
    "点点够",
    "数据库管理"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chenlaiyi/MysqlDestop.git"
  },
  "bugs": {
    "url": "https://github.com/chenlaiyi/MysqlDestop/issues"
  },
  "homepage": "https://github.com/chenlaiyi/MysqlDestop#readme",
  "author": "Bluce Chen and contributors",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^9.2.0",
    "ace-builds": "^1.43.1",
    "electron-store": "^10.1.0",
    "mysql2": "^3.14.1",
    "react": "^19.1.0",
    "react-ace": "^14.0.1",
    "react-dom": "^19.1.0",
    "sql-formatter": "^15.6.6",
    "ssh2": "^1.17.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ssh2": "^1.15.5",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "39.8.5",
    "electron-builder": "^26.15.3",
    "html-webpack-plugin": "^5.6.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "appId": "com.diandian.mysql-client-release",
    "productName": "点点够MySQL客户端",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ]
    },
    "dmg": {
      "title": "点点够MySQL客户端 ${version}",
      "icon": "assets/icon.icns",
      "iconSize": 80,
      "contents": [
        {
          "x": 380,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 122,
          "y": 180,
          "type": "file"
        }
      ],
      "window": {
        "width": 500,
        "height": 350
      }
    }
  }
}
